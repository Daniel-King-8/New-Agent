# Captain 部署环境变量
TZ=Asia/Shanghai
DATA_DIR=./data
CAPTAIN_PORT=8080

# 必填：用于加密 /data 下的 API Key。首次部署前固定下来，之后不要改，
# 否则已有密钥无法解密。
CAPTAIN_MASTER_KEY=please-change-me-to-a-long-random-string

# Hermes Agent 引擎
# 如果使用外部 Hermes，把 HERMES_BASE_URL / HERMES_DASHBOARD_URL 指向它，
# 并把 profiles 里的 hermes 服务去掉。
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=change-me
HERMES_DASHBOARD_URL=http://hermes:9119
HERMES_DASHBOARD_SESSION_TOKEN=change-me-at-least-32-characters
HERMES_HOME=./data/hermes

# QQ / NapCat
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_WEBUI_TOKEN=change-me
NAPCAT_ACCESS_TOKEN=change-me
NAPCAT_WS_URL=ws://napcat:3001
NAPCAT_WEBUI_URL=http://napcat:6099
NAPCAT_WEBUI_PORT=6099
